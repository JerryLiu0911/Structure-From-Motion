# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
# (conda envs live in the conda prefix, not in the repo)

# ─── Tool caches ─────────────────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ─── IDEs ────────────────────────────────────────────────────────────────────
# Track .vscode/settings.json (shared project settings) but ignore personal configs
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ─── OS artefacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*:Zone.Identifier

# ─── Project-specific data & outputs ─────────────────────────────────────────
# COLMAP projects folder (large binary image data — keep out of git)
/COLMAP_projects/

# COLMAP databases and reconstruction outputs
*.db
sparse/
dense/
outputs/
results/

# Image data directories (use !path to explicitly un-ignore specific tracked sets)

# Jupyter checkpoints
.ipynb_checkpoints/
*.ipynb
